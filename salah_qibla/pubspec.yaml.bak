name: salah_qibla
description: "Salah & Qibla — premium prayer times, Qibla compass and Hijri calendar app."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '^3.0.0'

dependencies:
  flutter:
    sdk: flutter

  # State Management
  flutter_riverpod: ^2.6.1

  # Networking
  dio: ^5.4.3+1

  # Storage
  shared_preferences: ^2.2.3

  # Location & Sensors
  geolocator: ^14.0.3
  flutter_compass: ^0.8.1
  sensors_plus: ^6.0.1

  # Google Maps
  google_maps_flutter: ^2.6.1

  # Utilities
  intl: ^0.19.0
  permission_handler: 11.3.1
  flutter_map: ^8.3.1
  latlong2: ^0.10.1
  http: ^1.6.0
  geocoding: ^5.0.0

  # Notifications & Alarms (Azaan alerts)
  flutter_local_notifications: ^18.0.1
  timezone: ^0.10.1
  android_alarm_manager_plus: ^4.0.4

  # Audio (Azaan playback)
  audioplayers: ^6.1.0
  
  # App Icon
  flutter_launcher_icons: ^0.14.4
  provider: ^6.1.5+1
  flutter_timezone: ^5.1.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
  
  # Assets
  assets:
    - assets/audio/
    - assets/icon/

# ============================================
# App Icon Configuration
# ============================================
flutter_launcher_icons:
  android: true
  ios: true
  image_path: "assets/icon/app_icon.png"
  web:
    generate: true
    image_path: "assets/icon/app_icon.png"